---
anatomy:
  - { name: "Repairs Service", need: "How fast will it be fixed?", words: 185, on: true }
  - { name: "Request a Repair", need: "How do I report it?", words: 88, on: true }
  - { name: "Right to Repair", need: "What if it's late?", words: 255, on: true }
  - { name: "Landlord & Tenant Responsibilities", need: "Is it my job or theirs?", words: 880, on: true }
  - { name: "Service Level", need: "Satisfaction scores", words: 154, on: false }
  - { name: "Planned & Cyclical Maintenance", need: "Budgets and programmes", words: 411, on: false }
  - { name: "Chargeable Repairs", need: "Will I have to pay?", words: 161, on: true }
audit:
  - [ "Repairs Service: intro", "Questions asked so repairs are fixed first time", "What will I be asked?", "change", "Rewrite", "“We'll ask” list under How to report" ]
  - [ "Repair categories table", "Emergency, urgent and routine, in legal terms", "How fast will it be fixed?", "change", "Rewrite", "How quickly we'll fix it, in plain words" ]
  - [ "Request a Repair: intro", "Check responsibilities before reporting", "Is it my job?", "move", "Move", "Its own heading lower down, so urgent repairs aren't held up" ]
  - [ "4 ways to report", "Office, phone, email, online", "How do I report it?", "keep", "Keep, move up", "Second on the page" ]
  - [ "Out-of-hours number", "A second number, inside a sentence", "Is it an emergency?", "change", "Rewrite, move up", "The emergency box, first on the page" ]
  - [ "“Click here” link", "Goes to the general Forms page", "How do I report it?", "change", "Rewrite", "“Report a repair online”, straight to the form" ]
  - [ "Right to Repair: intro", "Legal right to some repairs on time", "What if it's late?", "change", "Rewrite", "Your Right to Repair" ]
  - [ "Right to Repair: 19-row table", "Every qualifying repair and its time limit", "Is my repair covered?", "move", "Move", "Its own page. 3 examples stay" ]
  - [ "Our responsibilities table", "15 parts of the home the association repairs", "Is it their job?", "change", "Rewrite", "Repairs we do, grouped by part of the home" ]
  - [ "Tenant responsibilities", "Minor repairs, decorating, not wear and tear", "Is it my job?", "move", "Merge", "Repairs you do" ]
  - [ "Repairs reporting", "Report damage as soon as possible", "When do I report it?", "keep", "Keep", "The page's opening sentence" ]
  - [ "Emergencies", "Tell us at once, and we may force entry", "What happens in an emergency?", "change", "Rewrite", "Emergency box and After you report" ]
  - [ "Smoke and CO alarms", "Test them and change batteries", "Is it my job?", "move", "Merge", "Repairs you do" ]
  - [ "Access", "Let contractors in, they'll phone first", "What happens next?", "keep", "Keep", "After you report a repair" ]
  - [ "Cold weather", "Stop pipes freezing", "Looking after my home", "move", "Move", "Looking after your home page" ]
  - [ "Health & Safety", "No DIY that affects safety. Ask first", "Can I fix it myself?", "change", "Rewrite", "One line under Repairs you do" ]
  - [ "Artex", "Textured finishes need permission", "Decorating rules", "move", "Move", "Looking after your home page" ]
  - [ "Floor coverings", "Permission for hard floors. Flooring not put back", "What happens to my floor?", "change", "Rewrite", "The warning goes in After you report" ]
  - [ "Insurance and garden", "Contents insurance, tidy gardens", "Looking after my home", "move", "Move", "Looking after your home page" ]
  - [ "Miscellaneous repairs", "Glass, plugs, handles, pests, keys", "Is it my job?", "move", "Merge", "Repairs you do" ]
  - [ "Service Level", "Satisfaction results, 2019 and 2022", "None on this page", "cut", "Cut", "Linked as “How we're performing”" ]
  - [ "Planned & Cyclical Maintenance", "7 paragraphs on budgets, 14 checks", "None for reporting a repair", "cut", "Cut", "Linked as “Planned work on your home”" ]
  - [ "Chargeable Repairs", "When tenants pay, and instalments", "Will I have to pay?", "keep", "Keep, rewrite", "When you'll have to pay for a repair" ]
---
